{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Events",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "englishTitle": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "konkaniTitle": {
      "type": "string",
      "required": true
    },
    "eventImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "shortDescriptionEn": {
      "type": "string",
      "required": true
    },
    "shortDescriptionKok": {
      "type": "string",
      "required": true
    },
    "descriptionEn": {
      "type": "blocks",
      "required": true
    },
    "descriptionKok": {
      "type": "blocks",
      "required": true
    },
    "facebookLink": {
      "type": "string"
    },
    "instagramLink": {
      "type": "string"
    },
    "eventDate": {
      "type": "date",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "englishTitle",
      "required": true
    },
    "association": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::association.association",
      "inversedBy": "events"
    },
    "pastoralCommissions": {
      "type": "enumeration",
      "enum": ["Parish Pastoral Commissions", "None"]
    }
  }
}
